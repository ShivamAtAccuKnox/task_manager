# --- Secrets & Environment ---
.env
# Keep example.env so others know what variables are needed
!example.env

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# --- Celery ---
# You have this in your root; it changes constantly and breaks builds if committed
celerybeat-schedule

# --- IDE & Editors ---
.idea/
.vscode/
*.swp
*.swo

# --- Specific Project Files ---
# 'project.http' often contains test tokens/cookies. 
# Best to ignore unless it's a shared template.
project.http

# Scratch files
file.txt

# --- Data ---
# Assuming 'data/' is for local storage/mounts, ignore its contents
data/*
!data/.gitkeep